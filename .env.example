# Supabase project settings. The publishable key is safe for browser use when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only key. Never prefix this with NEXT_PUBLIC_ or expose it to client code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Future integrations. Keep all secret values server-side.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
GOOGLE_MAPS_SERVER_API_KEY=your-google-maps-server-key
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# Generate a base64-encoded 32-byte key (for example: openssl rand -base64 32).
# Keep this stable across deployments or saved gateway credentials cannot be decrypted.
PAYMENT_CONFIG_ENCRYPTION_KEY=your-base64-encoded-32-byte-key
RESEND_API_KEY=your-resend-api-key
SMS_PROVIDER_API_KEY=your-sms-provider-api-key
